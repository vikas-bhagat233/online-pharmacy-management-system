# Example environment variables for the backend
# Copy this to .env and fill values (do NOT commit secrets)

PORT=5000
MONGODB_URI=YOUR_MONGODB_URI
JWT_SECRET=YOUR_JWT_SECRET
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_secret
PAYPAL_MODE=sandbox
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# Optional: send admin notifications here (defaults to ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=admin_notify@example.com

# Optional: COD surcharge (INR)
COD_SURCHARGE_INR=30

# Admin bootstrap (created/updated on server start)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@pharmacy.com
ADMIN_PASSWORD=change_me
# Set to true to reset password on every startup
ADMIN_PASSWORD_FORCE=false

# Optional: set to true to update admin password only if it doesn't match
ADMIN_PASSWORD_SYNC=true

# Cloudinary (example)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
